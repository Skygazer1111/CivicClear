generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  citizen
  official
  admin
}

enum ComplaintType {
  pothole
  garbage
  streetlight
  drainage
  other
}

enum ComplaintStatus {
  submitted
  verified
  in_progress
  resolved
  rejected
}

enum Priority {
  low
  medium
  high
}

model User {
  id           String   @id @default(cuid())
  role         Role     @default(citizen)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  aadhaarHash  String?
  points       Int      @default(0)
  createdAt    DateTime @default(now())

  complaints Complaint[]       @relation("CitizenComplaints")
  assigned   Complaint[]       @relation("AssignedOfficial")
  events     ComplaintEvent[]
  rewards    RewardLedger[]
}

model Complaint {
  id                 String          @id @default(cuid())
  publicRef          String          @unique
  citizenId          String
  citizen            User            @relation("CitizenComplaints", fields: [citizenId], references: [id])
  type               ComplaintType
  title              String
  description        String
  lat                Float?
  lng                Float?
  addressText        String?
  status             ComplaintStatus @default(submitted)
  priority           Priority        @default(medium)
  assignedOfficialId String?
  assignedOfficial   User?           @relation("AssignedOfficial", fields: [assignedOfficialId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  resolvedAt         DateTime?

  photos  ComplaintPhoto[]
  events  ComplaintEvent[]
  rewards RewardLedger[]
}

model RewardLedger {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  delta       Int
  reason      String
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
  @@unique([complaintId, reason])
}

model ComplaintPhoto {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  url         String
  width       Int?
  height      Int?
}

model ComplaintEvent {
  id          String           @id @default(cuid())
  complaintId String
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User             @relation(fields: [actorId], references: [id])
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus
  note        String?
  createdAt   DateTime         @default(now())
}
