# Copy to civicclear/.env (Next.js does not load env from the repo root).
#   cp civicclear/.env.example civicclear/.env

# ---------------------------------------------------------------------------
# Postgres (required)
# ---------------------------------------------------------------------------
# Paste the connection string from Neon, Supabase, or local Postgres.
#
# Neon: https://console.neon.tech  → connect → Prisma
#   Use the *direct* (non-pooled) URI for Prisma db push / migrate.
#   Add ?sslmode=require if it is not already on the URL.
#
# Supabase: https://supabase.com/dashboard → Project Settings → Database
#   URI mode, use the "URI" connection string.
#
# Local Docker (from repo root): docker compose up -d
#   postgresql://CampusClean:CampusClean@localhost:5432/CampusClean
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/CampusClean?sslmode=require"

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Admin invite (required). This is the only admin — not hardcoded in the app.
# First sign-in on /login emails a code; they set name, mobile, and password.
# Do not put the admin password here.
ADMIN_EMAIL="admin@yourcampus.edu"

# ---------------------------------------------------------------------------
# Brevo email (student OTP). Free tier: https://app.brevo.com
# Without BREVO_API_KEY, codes are logged + shown in the UI in development.
# ---------------------------------------------------------------------------
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@yourdomain.com"
BREVO_FROM_NAME="CampusClean"

# Cloudinary (photos). Required on Vercel unless you use Vercel Blob instead.
# Locally, if unset, photos are saved under public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional on Vercel: Storage → Blob → create store → copy read-write token
BLOB_READ_WRITE_TOKEN=""

# Maps use Leaflet + OpenStreetMap. No API key required.
